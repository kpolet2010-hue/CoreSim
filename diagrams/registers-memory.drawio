        <mxCell id="coresim-memory-23" value="write32:&amp;nbsp;byte&amp;nbsp;i&amp;nbsp;=&amp;nbsp;(value&amp;nbsp;&amp;gt;&amp;gt;&amp;nbsp;(8&amp;nbsp;*&amp;nbsp;i))&amp;nbsp;&amp;amp;&amp;nbsp;0xFF&amp;nbsp;&amp;nbsp;&amp;rarr;&amp;nbsp;address&amp;nbsp;+&amp;nbsp;i&lt;br&gt;read32:&amp;nbsp;&amp;nbsp;value&amp;nbsp;|=&amp;nbsp;byte(address&amp;nbsp;+&amp;nbsp;i)&amp;nbsp;&amp;lt;&amp;lt;&amp;nbsp;(8&amp;nbsp;*&amp;nbsp;i)&lt;br&gt;&lt;br&gt;read32(0x100)&amp;nbsp;&amp;nbsp;&amp;rarr;&amp;nbsp;&amp;nbsp;0x12345678" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="920" height="90" as="geometry"/></mxCell>
