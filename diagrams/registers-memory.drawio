        <mxCell id="coresim-memory-3" value="class Memory &amp;middot; Memory.h &amp;middot; 256 KB &amp;middot; byte-addressable &amp;middot; little-endian" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1060" height="24" as="geometry"/></mxCell>
        <mxCell id="coresim-memory-4" value='Address space&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;18-bit addresses &amp;middot; 262,144 bytes (kMemorySize)&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#f7fbf5;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1060" height="280" as="geometry"/></mxCell>
        <mxCell id="coresim-memory-5" value="&lt;b&gt;RAM&lt;/b&gt; &amp;middot; 262,144 bytes &amp;middot; every address holds 1 byte &amp;middot; all bytes start at 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="136" width="980" height="44" as="geometry"/></mxCell>
        <mxCell id="coresim-memory-6" value="&lt;code&gt;0x00000&lt;/code&gt; first byte" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="182" width="200" height="16" as="geometry"/></mxCell>
        <mxCell id="coresim-memory-7" value="last byte &lt;code&gt;0x3FFFF&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#666666;align=right;" vertex="1" parent="1"><mxGeometry x="840" y="182" width="200" height="16" as="geometry"/></mxCell>
        <mxCell id="coresim-memory-8" value="&lt;code&gt;0x40000&lt;/code&gt; and above &amp;rarr; &lt;b&gt;error&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#b85450;align=right;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="240" height="24" as="geometry"/></mxCell>
        <mxCell id="coresim-memory-9" value="Memory()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;256&amp;nbsp;KB,&amp;nbsp;all&amp;nbsp;0&lt;br&gt;read8(address)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;rarr;&amp;nbsp;uint8&amp;nbsp;&amp;nbsp;&amp;nbsp;one&amp;nbsp;byte&lt;br&gt;write8(address,&amp;nbsp;value)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one&amp;nbsp;byte&lt;br&gt;read16(address)&amp;nbsp;&amp;nbsp;&amp;rarr;&amp;nbsp;Word&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;2&amp;nbsp;bytes,&amp;nbsp;little-endian&lt;br&gt;write16(address,&amp;nbsp;value)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;2&amp;nbsp;bytes,&amp;nbsp;little-endian&lt;br&gt;read32(address)&amp;nbsp;&amp;nbsp;&amp;rarr;&amp;nbsp;uint32&amp;nbsp;&amp;nbsp;4&amp;nbsp;bytes,&amp;nbsp;little-endian&lt;br&gt;write32(address,&amp;nbsp;value)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;4&amp;nbsp;bytes,&amp;nbsp;little-endian&lt;br&gt;reset()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;all&amp;nbsp;bytes&amp;nbsp;=&amp;nbsp;0&lt;br&gt;size()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;rarr;&amp;nbsp;262144" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="208" width="560" height="142" as="geometry"/></mxCell>
        <mxCell id="coresim-memory-10" value="No alignment rule: the 16- and 32-bit accesses work at any address as long as all bytes fit.&lt;br&gt;&lt;code&gt;CPU::reset()&lt;/code&gt; does &lt;b&gt;not&lt;/b&gt; clear memory &amp;ndash; use &lt;code&gt;Memory::reset()&lt;/code&gt;." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="640" y="212" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-memory-11" value='Little-endian&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;write32(0x100, 0x12345678) &amp;rarr; lowest byte at the lowest address&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#f7fbf5;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="1060" height="250" as="geometry"/></mxCell>
