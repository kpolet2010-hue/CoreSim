        <mxCell id="coresim-memory-14" value='&lt;b&gt;0x34&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#666666"&gt;byte 2&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="200" y="458" width="100" height="44" as="geometry"/></mxCell>
