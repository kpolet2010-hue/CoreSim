        <mxCell id="coresim-registers-57" value="value&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0100&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0001&lt;br&gt;kAddressMask&amp;nbsp;&amp;nbsp;0011&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&lt;br&gt;-------------------------------------&amp;nbsp;AND&lt;br&gt;pc_&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0001" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="480" height="96" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-58" value="Bit 18 does not exist in an 18-bit register, so the mask removes it. &lt;code&gt;setPc(0x40001)&lt;/code&gt; stores &lt;code&gt;0x00001&lt;/code&gt;, &lt;code&gt;setDbr(4)&lt;/code&gt; stores &lt;code&gt;0&lt;/code&gt;." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="480" height="60" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-59" value='FLAGS register&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;enum Flag&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#fbf9fc;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="730" width="520" height="230" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-60" value='&lt;b&gt;V&lt;/b&gt;&amp;nbsp;&lt;font style="font-size:11px"&gt;Overflow&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="580" y="776" width="110" height="34" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-61" value="bit 3 &amp;middot; kFlagV = 0x8" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="812" width="110" height="18" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-62" value='&lt;b&gt;C&lt;/b&gt;&amp;nbsp;&lt;font style="font-size:11px"&gt;Carry&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="776" width="110" height="34" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-63" value="bit 2 &amp;middot; kFlagC = 0x4" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="812" width="110" height="18" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-64" value='&lt;b&gt;N&lt;/b&gt;&amp;nbsp;&lt;font style="font-size:11px"&gt;Negative&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="820" y="776" width="110" height="34" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-65" value="bit 1 &amp;middot; kFlagN = 0x2" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="812" width="110" height="18" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-66" value='&lt;b&gt;Z&lt;/b&gt;&amp;nbsp;&lt;font style="font-size:11px"&gt;Zero&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="776" width="110" height="34" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-67" value="bit 0 &amp;middot; kFlagZ = 0x1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="940" y="812" width="110" height="18" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-68" value="flags&amp;nbsp;=&amp;nbsp;0101&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(Z&amp;nbsp;and&amp;nbsp;C&amp;nbsp;set)&lt;br&gt;setFlag(kFlagZ,&amp;nbsp;false):&amp;nbsp;&amp;nbsp;0101&amp;nbsp;&amp;amp;&amp;nbsp;~0001&amp;nbsp;=&amp;nbsp;0100&lt;br&gt;setFlag(kFlagN,&amp;nbsp;true):&amp;nbsp;&amp;nbsp;&amp;nbsp;0100&amp;nbsp;|&amp;nbsp;&amp;nbsp;0010&amp;nbsp;=&amp;nbsp;0110&lt;br&gt;flag(kFlagC):&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0110&amp;nbsp;&amp;amp;&amp;nbsp;&amp;nbsp;0100&amp;nbsp;&amp;rarr;&amp;nbsp;true" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="580" y="840" width="480" height="80" as="geometry"/></mxCell>
        <mxCell id="coresim-registers-69" value="Setting or clearing one flag never changes the others." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="926" width="480" height="24" as="geometry"/></mxCell>
      </root>
