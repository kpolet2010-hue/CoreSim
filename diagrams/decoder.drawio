        <mxCell id="coresim-decoder-15" value="opcode&amp;nbsp;=&amp;nbsp;(instr&amp;nbsp;&amp;gt;&amp;gt;&amp;nbsp;24)&amp;nbsp;&amp;amp;&amp;nbsp;0xFF;&lt;br&gt;format&amp;nbsp;=&amp;nbsp;opcode&amp;nbsp;&amp;gt;&amp;gt;&amp;nbsp;6;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;0..3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="300" height="52" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-16" value="8 opcode bits &amp;minus; 2 format bits = shift by &lt;b&gt;6&lt;/b&gt;. &lt;code&gt;opcode &amp;gt;&amp;gt; 6&lt;/code&gt; can only be 0&amp;ndash;3, so every opcode belongs to exactly one format." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="280" width="300" height="50" as="geometry"/></mxCell>
