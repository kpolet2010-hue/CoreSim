        <mxCell id="coresim-decoder-130" value="&lt;b&gt;R&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#e0e0e0;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1030" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-131" value="&lt;b&gt;I&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="332" y="1030" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-132" value="&lt;b&gt;M&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#e0e0e0;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="384" y="1030" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-133" value="&lt;b&gt;J&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#e0e0e0;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="436" y="1030" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-134" value="15&amp;ndash;0 &amp;middot; constant value" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="1028" width="540" height="32" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-135" value="&lt;b&gt;offset&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="1068" width="120" height="32" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-136" value="&lt;code&gt;int32_t&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="1068" width="90" height="32" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-137" value="&lt;b&gt;R&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#e0e0e0;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1070" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-138" value="&lt;b&gt;I&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#e0e0e0;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="332" y="1070" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-139" value="&lt;b&gt;M&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="384" y="1070" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-140" value="&lt;b&gt;J&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#e0e0e0;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="436" y="1070" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-141" value="15&amp;ndash;0 &amp;middot; sign-extended: 0xFFFC &amp;rarr; &amp;minus;4" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="1068" width="540" height="32" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-142" value="&lt;b&gt;address&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="1108" width="120" height="32" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-143" value="&lt;code&gt;uint32_t&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="1108" width="90" height="32" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-144" value="&lt;b&gt;R&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#e0e0e0;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1110" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-145" value="&lt;b&gt;I&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#e0e0e0;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="332" y="1110" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-146" value="&lt;b&gt;M&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#e0e0e0;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="384" y="1110" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-147" value="&lt;b&gt;J&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="436" y="1110" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-148" value="17&amp;ndash;0 &amp;middot; 18-bit address, 0x00000&amp;ndash;0x3FFFF" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="1108" width="540" height="32" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Shift &amp; Mask" id="coresim-decoder-shift">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1160" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="coresim-decoder-shift-2" value="Instruction Decoder &amp;ndash; Shift &amp;amp; Mask" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1060" height="36" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-3" value="How each field is cut out of the 32-bit instruction" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1060" height="24" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-4" value='The rule&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;the same two steps for every field&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#fbf9fc;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1060" height="200" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-5" value="&lt;b&gt;1. Shift right&lt;/b&gt; by the field's &lt;b&gt;lowest bit number&lt;/b&gt; &amp;rarr; the field moves to bit 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Mask&lt;/b&gt; with as many 1-bits as the field is wide &amp;rarr; everything left of the field is removed." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="50" y="134" width="480" height="110" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-6" value="&lt;b&gt;Width&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="134" width="100" height="20" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-7" value="&lt;b&gt;Mask&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="690" y="134" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-8" value="&lt;b&gt;Fields&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="134" width="160" height="20" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-9" value="4 bit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="158" width="100" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-10" value="&lt;code&gt;0x0F&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="158" width="200" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-11" value="rd, rs1, rs2" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="158" width="160" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-12" value="8 bit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="188" width="100" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-13" value="&lt;code&gt;0xFF&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="188" width="200" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-14" value="opcode" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="188" width="160" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-15" value="16 bit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="218" width="100" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-16" value="&lt;code&gt;0xFFFF&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="218" width="200" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-17" value="immediate, offset" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="218" width="160" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-18" value="18 bit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="248" width="100" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-19" value="&lt;code&gt;0x3FFFF = kAddressMask&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="248" width="200" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-20" value="address" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="248" width="160" height="26" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-21" value='Example: rd&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;R-format &amp;middot; bits 23&amp;ndash;20 &amp;middot; 0x12345000&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#f8fbff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="1060" height="170" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-22" value="instr&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0001&amp;nbsp;0010&amp;nbsp;0011&amp;nbsp;0100&amp;nbsp;0101&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;&amp;nbsp;&amp;nbsp;0x12345000&lt;br&gt;instr&amp;nbsp;&amp;gt;&amp;gt;&amp;nbsp;20&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0001&amp;nbsp;0010&amp;nbsp;0011&amp;nbsp;&amp;nbsp;&amp;nbsp;0x123&lt;br&gt;&amp;amp;&amp;nbsp;0x0F&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;1111&lt;br&gt;=&amp;nbsp;rd&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0011&amp;nbsp;&amp;nbsp;&amp;nbsp;3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="760" height="96" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-23" value="Opcode &lt;code&gt;0x12&lt;/code&gt; = &lt;code&gt;00&lt;/code&gt;01 0010 &amp;rarr; R-format.&lt;br&gt;&lt;br&gt;The shift leaves &lt;code&gt;0x123&lt;/code&gt;; the mask keeps only the last hex digit." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="356" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-24" value='Example: offset&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;M-format &amp;middot; bits 15&amp;ndash;0 &amp;middot; 0x8012FFFC&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#fffaf3;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1060" height="220" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-25" value="instr&amp;nbsp;&amp;amp;&amp;nbsp;0xFFFF&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1100&amp;nbsp;&amp;nbsp;&amp;nbsp;0xFFFC&lt;br&gt;&lt;br&gt;as&amp;nbsp;uint16_t&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;65532&lt;br&gt;static_cast&amp;lt;int16_t&amp;gt;(...)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;top&amp;nbsp;bit&amp;nbsp;1&amp;nbsp;&amp;rarr;&amp;nbsp;negative&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-4&lt;br&gt;stored&amp;nbsp;in&amp;nbsp;int32_t&amp;nbsp;offset&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sign&amp;nbsp;kept&amp;nbsp;(0xFFFFFFFC)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="546" width="760" height="112" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-26" value="The offset can point backwards (&lt;code&gt;[R2 - 4]&lt;/code&gt;), so it is &lt;b&gt;signed&lt;/b&gt;.&lt;br&gt;&lt;br&gt;The cast to &lt;code&gt;int16_t&lt;/code&gt; reads bit 15 as the sign. Converting to &lt;code&gt;int32_t&lt;/code&gt; copies that sign (&lt;i&gt;sign extension&lt;/i&gt;)." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="546" width="240" height="160" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-27" value="&lt;code&gt;0x80120008&lt;/code&gt; &amp;rarr; bit 15 is 0 &amp;rarr; offset stays &lt;b&gt;+8&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="672" width="760" height="24" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-28" value='Example: address&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;J-format &amp;middot; bits 17&amp;ndash;0 &amp;middot; 0xFFFFFFFF&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1060" height="170" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-29" value="instr&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;&amp;nbsp;&amp;nbsp;0xFFFFFFFF&lt;br&gt;&amp;amp;&amp;nbsp;kAddressMask&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0011&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;&amp;nbsp;&amp;nbsp;0x3FFFF&lt;br&gt;=&amp;nbsp;address&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0000&amp;nbsp;0011&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;1111&amp;nbsp;&amp;nbsp;&amp;nbsp;0x3FFFF" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="760" height="76" as="geometry"/></mxCell>
        <mxCell id="coresim-decoder-shift-30" value="Opcode &lt;code&gt;0xFF&lt;/code&gt; = &lt;code&gt;11&lt;/code&gt;11 1111 &amp;rarr; J-format.&lt;br&gt;&lt;br&gt;No shift needed: the field already starts at bit 0. rd, rs1, rs2 stay &lt;b&gt;0&lt;/b&gt;." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="786" width="240" height="110" as="geometry"/></mxCell>
