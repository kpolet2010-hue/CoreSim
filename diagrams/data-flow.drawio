        <mxCell id="coresim-dataflow-10" value='Components&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;include/coresim/&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1060" height="330" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-11" value='&lt;b&gt;CPU&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;CPU.h &amp;middot; reset() &amp;rarr; registers_.reset() + state_.reset()&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=14;fontStyle=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="560" height="200" as="geometry"/></mxCell>
