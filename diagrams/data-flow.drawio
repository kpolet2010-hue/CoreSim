        <mxCell id="coresim-dataflow-13" value='&lt;b&gt;CPUState&lt;/b&gt; &amp;middot; &lt;code&gt;state_&lt;/code&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PC &amp;middot; SP &amp;middot; IR &amp;middot; DBR &amp;middot; FLAGS&lt;/font&gt;&lt;br&gt;&lt;code style="font-size:11px"&gt;state()&lt;/code&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="390" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-14" value='&lt;b&gt;Memory&lt;/b&gt; &amp;middot; &lt;code&gt;memory_&lt;/code&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;256 KB RAM&lt;/font&gt;&lt;br&gt;&lt;code style="font-size:11px"&gt;memory()&lt;/code&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-15" value='&lt;b&gt;Decoder&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;stand-alone &amp;middot; no state&lt;br&gt;not owned by CPU&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-16" value="reference&lt;br&gt;(Memory&amp;amp;)" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;labelBackgroundColor=#fafafa;" edge="1" parent="1" source="coresim-dataflow-11" target="coresim-dataflow-14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-17" value="&lt;b&gt;owns&lt;/b&gt;: member of the CPU,&lt;br&gt;created and destroyed with it&lt;br&gt;&lt;br&gt;&lt;b&gt;reference&lt;/b&gt;: created outside,&lt;br&gt;passed into the constructor,&lt;br&gt;must outlive the CPU" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="935" y="330" width="140" height="190" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-18" value="Memory&amp;nbsp;memory;&lt;br&gt;CPU&amp;nbsp;cpu(memory);&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;CPU&amp;nbsp;keeps&amp;nbsp;a&amp;nbsp;reference" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="50" y="548" width="560" height="46" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-19" value="&lt;b&gt;Architecture.h&lt;/b&gt; &amp;middot; &lt;code&gt;Word&lt;/code&gt; = uint16 &amp;middot; &lt;code&gt;Instruction&lt;/code&gt; = uint32 &amp;middot; &lt;code&gt;Address&lt;/code&gt; = uint32 (18 bit used)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="630" y="548" width="440" height="46" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-20" value='Data flow&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;as it can be done today &amp;ndash; by calling the classes directly&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1060" height="330" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-21" value='&lt;b&gt;Memory&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;0x100: 78 56 34 12&lt;br&gt;(little-endian)&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-22" value='&lt;b&gt;Instruction&lt;/b&gt;&lt;br&gt;&lt;code&gt;0x12345678&lt;/code&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;32 bit&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="690" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-23" value='&lt;b&gt;Decoder&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;shift + mask&lt;br&gt;per field&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="690" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-24" value='&lt;b&gt;DecodedInstruction&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;opcode = 0x12&lt;br&gt;rd = 3 &amp;middot; rs1 = 4 &amp;middot; rs2 = 5&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f3eef7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="890" y="690" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-25" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="coresim-dataflow-21" target="coresim-dataflow-22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-26" value="&lt;code&gt;read32(0x100)&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="225" y="705" width="110" height="20" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-27" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="coresim-dataflow-22" target="coresim-dataflow-23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-28" value="&lt;code&gt;decode(instr)&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="505" y="705" width="110" height="20" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-29" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="coresim-dataflow-23" target="coresim-dataflow-24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-30" value="returns" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="785" y="705" width="110" height="20" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-31" value="Memory&amp;nbsp;memory;&lt;br&gt;memory.write32(0x100,&amp;nbsp;0x12345678);&lt;br&gt;&lt;br&gt;Instruction&amp;nbsp;instr&amp;nbsp;&amp;nbsp;=&amp;nbsp;memory.read32(0x100);&lt;br&gt;DecodedInstruction&amp;nbsp;d&amp;nbsp;=&amp;nbsp;Decoder().decode(instr);&lt;br&gt;//&amp;nbsp;d.opcode&amp;nbsp;==&amp;nbsp;0x12,&amp;nbsp;d.rd&amp;nbsp;==&amp;nbsp;3,&amp;nbsp;d.rs1&amp;nbsp;==&amp;nbsp;4,&amp;nbsp;d.rs2&amp;nbsp;==&amp;nbsp;5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="50" y="815" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-32" value="&lt;i&gt;The CPU does not fetch, decode or execute instructions on its own yet. These steps are called directly, e.g. in &lt;code&gt;tests/&lt;/code&gt; and &lt;code&gt;src/main.cpp&lt;/code&gt;.&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="815" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-33" value='Error handling&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;std::out_of_range&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="980" width="1060" height="130" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-34" value="&lt;b&gt;Memory&lt;/b&gt;&lt;br&gt;any byte outside 0x00000&amp;ndash;0x3FFFF" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="1030" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-35" value="&lt;b&gt;Register&lt;/b&gt;&lt;br&gt;register index &amp;ge; 16" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1030" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-36" value="&lt;b&gt;CPUState&lt;/b&gt;&lt;br&gt;never throws &amp;ndash; values are masked" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="1030" width="340" height="56" as="geometry"/></mxCell>
