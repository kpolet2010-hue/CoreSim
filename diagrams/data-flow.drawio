        <mxCell id="coresim-dataflow-16" value="reference&lt;br&gt;(Memory&amp;amp;)" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.15;entryX=0;entryY=0.5;labelBackgroundColor=#fafafa;" edge="1" parent="1" source="coresim-dataflow-11" target="coresim-dataflow-14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-17" value="owns" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#fafafa;" edge="1" parent="1" source="coresim-dataflow-11" target="coresim-dataflow-15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-39" value="owns" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;exitX=1;exitY=0.85;entryX=0;entryY=0.5;labelBackgroundColor=#fafafa;" edge="1" parent="1" source="coresim-dataflow-11" target="coresim-dataflow-38"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-18" value="&lt;b&gt;owns&lt;/b&gt;: member of the CPU,&lt;br&gt;created and destroyed with it&lt;br&gt;&lt;br&gt;&lt;b&gt;reference&lt;/b&gt;: created outside,&lt;br&gt;passed into the constructor,&lt;br&gt;must outlive the CPU" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="935" y="330" width="140" height="190" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-19" value="Memory&amp;nbsp;memory;&lt;br&gt;CPU&amp;nbsp;cpu(memory);&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;CPU&amp;nbsp;keeps&amp;nbsp;a&amp;nbsp;reference" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="50" y="548" width="560" height="46" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-20" value="&lt;b&gt;Architecture.h&lt;/b&gt; &amp;middot; &lt;code&gt;Word&lt;/code&gt; = uint16 &amp;middot; &lt;code&gt;Instruction&lt;/code&gt; = uint32 &amp;middot; &lt;code&gt;Address&lt;/code&gt; = uint32 (18 bit used)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="630" y="548" width="440" height="46" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-21" value='Data flow&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;one CPU::step()&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1060" height="330" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-22" value='&lt;b&gt;Memory&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;0x00000: 78 56 34 12&lt;br&gt;(little-endian)&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-23" value='&lt;b&gt;IR&lt;/b&gt;&lt;br&gt;&lt;code&gt;0x12345678&lt;/code&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;PC = PC + 4&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="690" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-24" value='&lt;b&gt;Decoder&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;opcode &amp;gt;&amp;gt; 6 &amp;rarr; format&lt;br&gt;shift + mask per field&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="690" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-25" value='&lt;b&gt;DecodedInstruction&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;opcode = 0x12&lt;br&gt;rd = 3 &amp;middot; rs1 = 4 &amp;middot; rs2 = 5&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f3eef7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="890" y="690" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-26" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="coresim-dataflow-22" target="coresim-dataflow-23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-27" value="&lt;code&gt;read32(PC)&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="225" y="705" width="110" height="20" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-28" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="coresim-dataflow-23" target="coresim-dataflow-24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-29" value="&lt;code&gt;decode(IR)&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="505" y="705" width="110" height="20" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-30" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="coresim-dataflow-24" target="coresim-dataflow-25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-31" value="returns" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="785" y="705" width="110" height="20" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-32" value="Memory&amp;nbsp;memory;&lt;br&gt;memory.write32(0x0000,&amp;nbsp;0x0D000000);&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;NOP&lt;br&gt;memory.write32(0x0004,&amp;nbsp;0x0E000000);&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;HLT&lt;br&gt;&lt;br&gt;CPU&amp;nbsp;cpu(memory);&lt;br&gt;cpu.step();&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;IR&amp;nbsp;=&amp;nbsp;0x0D000000,&amp;nbsp;PC&amp;nbsp;=&amp;nbsp;0x0004&lt;br&gt;cpu.step();&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;IR&amp;nbsp;=&amp;nbsp;0x0E000000,&amp;nbsp;PC&amp;nbsp;=&amp;nbsp;0x0008,&amp;nbsp;halted" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="50" y="815" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-33" value="&lt;i&gt;&lt;code&gt;step()&lt;/code&gt; fetches the instruction at PC into IR, advances PC by 4 and decodes it. Only &lt;b&gt;NOP&lt;/b&gt;, &lt;b&gt;HLT&lt;/b&gt;, &lt;b&gt;MOV&lt;/b&gt;, &lt;b&gt;MOVI&lt;/b&gt; and the ALU instructions are executed so far, all other opcodes do nothing. The ALU returns result and flags, the CPU stores them.&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="815" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-34" value='Error handling&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;std::out_of_range &amp;middot; std::runtime_error&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontFamily=Helvetica;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="980" width="1060" height="130" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-35" value="&lt;b&gt;Memory&lt;/b&gt;&lt;br&gt;any byte outside 0x00000&amp;ndash;0x3FFFF" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="1030" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-36" value="&lt;b&gt;Register&lt;/b&gt;&lt;br&gt;register index &amp;ge; 16" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1030" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-40" value="&lt;b&gt;ALU&lt;/b&gt;&lt;br&gt;DIV by zero (std::runtime_error)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="1030" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="coresim-dataflow-37" value="&lt;b&gt;CPUState&lt;/b&gt;&lt;br&gt;never throws &amp;ndash; values are masked" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="1030" width="240" height="56" as="geometry"/></mxCell>
      </root>
