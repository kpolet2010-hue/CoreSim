        <mxCell id="coresim-dataflow-11" value='&lt;b&gt;CPU&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:12px;color:#666666"&gt;CPU.h &amp;middot; step() &amp;middot; reset() &amp;middot; halted()&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=14;fontStyle=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="560" height="200" as="geometry"/></mxCell>
